<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12</LangVersion>
    <AssemblyName>VsCopilotChatVoice.Reader</AssemblyName>
    <StartupObject>ReadAlongTrial.Program</StartupObject>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\SpeechOptions.cs" Link="Shared\SpeechOptions.cs" />
    <Compile Include="..\Shared\SpeechCapabilities.cs" Link="Shared\SpeechCapabilities.cs" />
    <Compile Include="..\Shared\SpeechCapabilityQuery.cs" Link="Shared\SpeechCapabilityQuery.cs" />
    <Compile Include="..\Shared\ReaderDocument.cs" Link="Shared\ReaderDocument.cs" />
    <Compile Include="..\Shared\ReaderBlockValidation.cs" Link="Shared\ReaderBlockValidation.cs" />
    <Compile Include="..\Shared\SpeechWorkerProtocol.cs" Link="Shared\SpeechWorkerProtocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Speech" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
</Project>