<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="VsCopilotChatVoice.048978d7-5859-4691-8e64-d90e00c0462f" Version="0.5.6" Language="en-US" Publisher="VsCopilotChatVoice" />
    <DisplayName>VS Copilot Chat Voice (Preview)</DisplayName>
    <Description xml:space="preserve">Independent voice interaction for Visual Studio Copilot Chat. Preview with disabled voice toolbar controls; no microphone or reply-delivery feed. Copilot Voice Reader (Preview) preserves the sample Speak/Cancel view; an explicit Debug/Exp launch gate selects prepared paired-reply native controls using external speech. Migrated native runtime acceptance remains pending.</Description>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>